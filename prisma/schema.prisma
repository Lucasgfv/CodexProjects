datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Empresa {
  id                    String                @id @default(uuid())
  razaoSocial           String
  nomeFantasia          String?
  cnpj                  String                @unique
  tipoCliente           String?
  porte                 String?
  regimeTributario      String
  email                 String?
  telefone              String?
  cep                   String?
  endereco              String?
  numeroEndereco        String?
  bairro                String?
  cidade                String?
  uf                    String?               @db.VarChar(2)
  capitalSocial         Decimal?              @db.Decimal(12, 2)
  honorarioMensal       Decimal?              @db.Decimal(12, 2)
  inscricaoEstadual     String?
  inscricaoMunicipal    String?
  cnaePrincipal         String?
  cnaesSecundarios      String?
  ramoAtividade         String?
  servicoProduto        String?
  quantidadeFuncionarios Int?
  situacaoAlvaras       String?
  participaLicitacoes   Boolean?
  contadorAnterior      String?
  dataAtualizacaoBancaria DateTime?
  pendenciasFiscais     Boolean?
  ranking               String?
  dataInicio            DateTime
  dataBaixa             DateTime?
  socios                EmpresaSocio[]
  alteracoesContratuais AlteracaoContratual[]
  lancamentos           Lancamento[]
  referenciasComerciais ReferenciaComercial[]
  criadoEm              DateTime              @default(now())
  atualizadoEm          DateTime              @updatedAt
}

model ReferenciaComercial {
  id        String   @id @default(uuid())
  empresaId String
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nome      String
  cidade    String
  uf        String   @db.VarChar(2)

  @@index([empresaId])
}

model Socio {
  id             String         @id @default(uuid())
  nome           String
  cpf            String         @unique
  dataNascimento DateTime
  email          String?
  telefone       String?
  nacionalidade  String?
  estadoCivil    String?
  profissao      String?
  rg             String?
  orgaoEmissor   String?
  cep            String?
  endereco       String?
  cidade         String?
  uf             String?        @db.VarChar(2)
  empresas       EmpresaSocio[]
  criadoEm       DateTime       @default(now())
  atualizadoEm   DateTime       @updatedAt
}

model EmpresaSocio {
  id                     String    @id @default(uuid())
  empresaId              String
  empresa                Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  socioId                String
  socio                  Socio     @relation(fields: [socioId], references: [id], onDelete: Cascade)
  cargo                  String?
  percentualParticipacao Decimal   @db.Decimal(5, 2)
  recebeProlabore        Boolean   @default(false)
  valorProlabore         Decimal?  @db.Decimal(10, 2)
  dataEntrada            DateTime
  dataSaida              DateTime?

  @@unique([empresaId, socioId])
  @@index([empresaId])
  @@index([socioId])
}

model AlteracaoContratual {
  id                String   @id @default(uuid())
  empresaId         String
  empresa           Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  numeroAlteracao   Int?
  dataAlteracao     DateTime
  descricaoResumida String?
  criadoEm          DateTime @default(now())

  @@index([empresaId])
}

model Lancamento {
  id          String   @id @default(uuid())
  empresaId   String
  empresa     Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  tipo        String
  descricao   String
  valor       Decimal  @db.Decimal(12, 2)
  vencimento  DateTime
  competencia DateTime
  pago        Boolean  @default(false)
  criadoEm    DateTime @default(now())

  @@index([empresaId, competencia])
}

model FiscalEmpresa {
  id                String         @id @default(uuid())
  codigo            Int?
  nome              String
  cnpj              String         @unique
  cnpjDigits        String         @unique
  inscricaoEstadual String?
  regime            String
  responsavel       String
  observacoes       String         @default("")
  tarefas           FiscalTarefa[]
  criadoEm          DateTime       @default(now())
  atualizadoEm      DateTime       @updatedAt

  @@index([responsavel])
  @@index([regime])
}

model FiscalTarefa {
  id               String        @id @default(uuid())
  empresaId        String
  empresa          FiscalEmpresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  chave            String
  nome             String
  competencia      DateTime
  status           String
  valorOriginal    String?
  statusAlteradoEm DateTime       @default(now())
  criadoEm         DateTime       @default(now())
  atualizadoEm     DateTime       @updatedAt

  @@unique([empresaId, chave, competencia])
  @@index([competencia, status])
}

model FiscalMei {
  id                    String                 @id @default(uuid())
  nome                  String
  cnpj                  String                 @unique
  cnpjDigits            String                 @unique
  responsavel           String
  limiteReferencia      Decimal                @default(81000) @db.Decimal(12, 2)
  faturamentoConferido  Boolean                @default(false)
  inativo               Boolean                @default(false)
  observacoes           String                 @default("")
  certificadoDescricao String?
  certificadoAtivo     Boolean                @default(false)
  certificadoValidoAte DateTime?
  acessoCpf             String?
  acessoSenha           String?
  atividades            FiscalMeiAtividade[]
  faturamentos          FiscalMeiFaturamento[]
  criadoEm              DateTime               @default(now())
  atualizadoEm          DateTime               @updatedAt

  @@index([responsavel])
  @@index([certificadoAtivo])
}

model FiscalMeiAtividade {
  id               String    @id @default(uuid())
  meiId            String
  mei              FiscalMei @relation(fields: [meiId], references: [id], onDelete: Cascade)
  chave            String
  nome             String
  competencia      DateTime
  status           String
  statusAlteradoEm DateTime  @default(now())
  enviadoEm        DateTime?
  criadoEm         DateTime  @default(now())
  atualizadoEm     DateTime  @updatedAt

  @@unique([meiId, chave, competencia])
  @@index([competencia, status])
}

model FiscalMeiFaturamento {
  id           String    @id @default(uuid())
  meiId        String
  mei          FiscalMei @relation(fields: [meiId], references: [id], onDelete: Cascade)
  ano          Int
  mes          Int
  valor        Decimal   @default(0) @db.Decimal(12, 2)
  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt

  @@unique([meiId, ano, mes])
  @@index([ano, mes])
}

model FiscalConfiguracao {
  chave        String   @id
  valor        String
  atualizadoEm DateTime @updatedAt
}
