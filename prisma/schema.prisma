datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Empresa {
  id                    String                @id @default(uuid())
  razaoSocial           String
  nomeFantasia          String?
  cnpj                  String                @unique
  tipoCliente           String?
  porte                 String?
  regimeTributario      String
  email                 String?
  telefone              String?
  cep                   String?
  endereco              String?
  cidade                String?
  uf                    String?               @db.VarChar(2)
  capitalSocial         Decimal?              @db.Decimal(12, 2)
  honorarioMensal       Decimal?              @db.Decimal(12, 2)
  dataInicio            DateTime
  dataBaixa             DateTime?
  socios                EmpresaSocio[]
  alteracoesContratuais AlteracaoContratual[]
  lancamentos           Lancamento[]
  criadoEm              DateTime              @default(now())
  atualizadoEm          DateTime              @updatedAt
}

model Socio {
  id             String         @id @default(uuid())
  nome           String
  cpf            String         @unique
  dataNascimento DateTime
  email          String?
  telefone       String?
  nacionalidade  String?
  estadoCivil    String?
  profissao      String?
  rg             String?
  orgaoEmissor   String?
  cep            String?
  endereco       String?
  cidade         String?
  uf             String?        @db.VarChar(2)
  empresas       EmpresaSocio[]
  criadoEm       DateTime       @default(now())
  atualizadoEm   DateTime       @updatedAt
}

model EmpresaSocio {
  id                     String    @id @default(uuid())
  empresaId              String
  empresa                Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  socioId                String
  socio                  Socio     @relation(fields: [socioId], references: [id], onDelete: Cascade)
  cargo                  String?
  percentualParticipacao Decimal   @db.Decimal(5, 2)
  recebeProlabore        Boolean   @default(false)
  valorProlabore         Decimal?  @db.Decimal(10, 2)
  dataEntrada            DateTime
  dataSaida              DateTime?

  @@unique([empresaId, socioId])
  @@index([empresaId])
  @@index([socioId])
}

model AlteracaoContratual {
  id                String   @id @default(uuid())
  empresaId         String
  empresa           Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  numeroAlteracao   Int?
  dataAlteracao     DateTime
  descricaoResumida String?
  criadoEm          DateTime @default(now())

  @@index([empresaId])
}

model Lancamento {
  id          String   @id @default(uuid())
  empresaId   String
  empresa     Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  tipo        String
  descricao   String
  valor       Decimal  @db.Decimal(12, 2)
  vencimento  DateTime
  competencia DateTime
  pago        Boolean  @default(false)
  criadoEm    DateTime @default(now())

  @@index([empresaId, competencia])
}
